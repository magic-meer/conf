{
  "name": "87-key tri-mode RGB keyboard (258a:0049)",
  "layout": "ANSI 87-key (TKL without the gap block above arrows)",
  "keys": 87,
  "units": "u",
  "unit_size_px": null,
  "grid": {
    "formula": "slot = 1 + col * 6 + row",
    "columns": 17,
    "rows": 6,
    "row_names": [
      "f-row",
      "number",
      "qwerty",
      "home",
      "shift",
      "modifiers"
    ],
    "notes": [
      "slot 0 is unused",
      "row 0 has a phantom slot at col 1 (the esc-f1 gap), so f1 starts at col 2",
      "wide keys are mapped to the rightmost grid column they cover: enter=col13, rshift=col13",
      "bottom row grid columns are not physical x: space=col5, ralt=col8, fn=col9, menu=col10, rctrl=col13"
    ]
  },
  "frame": {
    "report": "0x0B",
    "bytes": 378,
    "slots": 126,
    "layout": "planar (channel-major)",
    "planes": {
      "red": [
        0,
        125
      ],
      "green": [
        126,
        251
      ],
      "blue": [
        252,
        377
      ]
    },
    "colorspace": {
      "wire": "linear (PWM duty, 0..255 per channel)",
      "designs": "sRGB",
      "conversion": "sRGB->linear applied by rgbset.py; pass --raw to send bytes untouched",
      "note": "a raw 48 renders as ~sRGB 125, and raw (10,10,20) renders as a clearly visible blue-grey -- which is what an sRGB (10,10,20) would NOT do"
    },
    "mode_register": "0x0A[1] must be 0x13 to render"
  },
