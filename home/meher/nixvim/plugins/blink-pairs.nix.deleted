{ ... }: {
   # Shared rainbow palette (tokyo-night colors). Also referenced by blink-indent
   # so the indentation guides use the exact same colors as the pairs.
   highlight = {
      # matched pair colors, per nesting depth
      BlinkPairsRainbow1.fg = "#f7768e"; # red
      BlinkPairsRainbow2.fg = "#ff9e64"; # orange
      BlinkPairsRainbow3.fg = "#e0af68"; # yellow
      BlinkPairsRainbow4.fg = "#9ece6a"; # green
      BlinkPairsRainbow5.fg = "#7dcfff"; # cyan
      BlinkPairsRainbow6.fg = "#bb9af7"; # purple
      # underline variants, used by blink-indent's active scope underline
      BlinkPairsRainbow1Underline = {
         fg = "#f7768e";
         underline = true;
      };
      BlinkPairsRainbow2Underline = {
         fg = "#ff9e64";
         underline = true;
      };
      BlinkPairsRainbow3Underline = {
         fg = "#e0af68";
         underline = true;
      };
      BlinkPairsRainbow4Underline = {
         fg = "#9ece6a";
         underline = true;
      };
      BlinkPairsRainbow5Underline = {
         fg = "#7dcfff";
         underline = true;
      };
      BlinkPairsRainbow6Underline = {
         fg = "#bb9af7";
         underline = true;
      };
   };

   plugins.blink-pairs = {
      enable = true;
      settings.highlights = {
         enabled = true;
         cmdline = true;
         groups = [
            "BlinkPairsRainbow1"
            "BlinkPairsRainbow2"
            "BlinkPairsRainbow3"
            "BlinkPairsRainbow4"
            "BlinkPairsRainbow5"
            "BlinkPairsRainbow6"
         ];
         unmatched_group = "BlinkPairsUnmatched";
      };
   };
}