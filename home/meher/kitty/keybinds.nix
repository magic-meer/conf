{
  # Kitty default keybindings — uncomment to override.
  # See `kitty --config kitty.conf --help` or the online docs:
  # https://sw.kovidgoyal.net/kitty/conf/#shortcut-kitty
  #
  # Format: map <mods+key> <action>
  # Use "kitty_mod" for the kitty modifier (ctrl+shift).
  #
  # Defaults (all commented = kitty's built-in defaults apply):
  # map kitty_mod+c copy_to_clipboard
  # map kitty_mod+v paste_from_clipboard
  # map shift+insert paste_from_selection
  # map kitty_mod+n new_window
  # map kitty_mod+upresize_window up
  # map kitty_mod+downresize_window down
  # map kitty_mod+leftresize_window left
  # map kitty_mod+rightresize_window right
  # map kitty_mod+plus increase_font_size
  # map kitty_mod+minus decrease_font_size
  # map kitty_mod+equal restore_font_size
  # map kitty_mod+home scroll_home
  # map kitty_mod+end scroll_end
  # map kitty_mod+page_up scroll_page_up
  # map kitty_mod+page_down scroll_page_down
  # map kitty_mod+s toggle_scrollback
  # map kitty_mod+f toggle_fullscreen
  # map kitty_mod+q close_window
}
